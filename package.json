{
  "name": "@pixdeo/weavekit",
  "version": "0.0.1",
  "description": "A declarative, SwiftUI-shaped UI toolkit that renders to <canvas>.",
  "type": "module",
  "main": "./dist-lib/weavekit.js",
  "module": "./dist-lib/weavekit.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/weavekit.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixdeo/weavekit.git"
  },
  "keywords": [
    "canvas",
    "ui",
    "layout",
    "swiftui",
    "declarative"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:layout": "vite build --ssr src/dev/layout-check.ts --outDir dist-check --logLevel error && node dist-check/layout-check.js",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts && npm run types",
    "types": "tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
